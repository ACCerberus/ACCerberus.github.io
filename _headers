# Cloudflare Pages response headers. Pages, scripts, styles, the changelog and the data manifest must always be
# revalidated so a new build shows up on the next load; vendor libraries and fonts keep normal caching.
/
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
/lightkeeper/
  Cache-Control: no-cache, must-revalidate
/lightkeeper/*.js
  Cache-Control: no-cache, must-revalidate
/lightkeeper/js/*
  Cache-Control: no-cache, must-revalidate
/lightkeeper/css/*
  Cache-Control: no-cache, must-revalidate
/lightkeeper/changelog.json
  Cache-Control: no-cache, must-revalidate
/lightkeeper/version.json
  Cache-Control: no-store
/lightkeeper/data/manifest.json
  Cache-Control: no-cache, must-revalidate

# Security for every page: run only this site's code and talk only to the data services the app uses (CSP);
# Cloudflare Web Analytics (its beacon script and inline loader) is allowed by name and hash;
# no showing the site inside another site's frame; location for this site only, no camera or microphone.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-2uJ8cPsQc8Zxdo9V/HKrqhnu/X6vJMqZASsIDHBuWgw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com https://*.tile.opentopomap.org https://gis.charttools.noaa.gov https://upload.wikimedia.org; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://tile.openstreetmap.org https://server.arcgisonline.com https://*.tile.opentopomap.org https://gis.charttools.noaa.gov https://api.tidesandcurrents.noaa.gov https://tidesandcurrents.noaa.gov https://waterservices.usgs.gov https://waterdata.usgs.gov https://api.weather.gov https://api.open-meteo.com https://marine-api.open-meteo.com https://overpass-api.de https://overpass.kumi.systems https://nominatim.openstreetmap.org https://photon.komoot.io https://services2.arcgis.com https://cwms-data.usace.army.mil https://router.project-osrm.org https://commons.wikimedia.org https://upload.wikimedia.org; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
