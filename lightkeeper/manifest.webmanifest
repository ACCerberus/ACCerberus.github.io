{
  "name": "LightKeeper",
  "short_name": "LightKeeper",
  "description": "USCG Light List, boat ramps, lodging, dams, tides, river gauges and weather on one map. By Evan Isakson.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
